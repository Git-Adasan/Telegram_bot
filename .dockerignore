# Never put credentials or authenticated Telegram sessions into an image.
.env
.env.*
!.env.example
*.session
*.session-journal
*.db
*.sqlite
*.sqlite3

# Local backups, caches, and repository metadata.
.git
.git/**
__pycache__/
*.py[cod]
# Только архивы копий и файлы до восстановления.
# НЕ писать "*_backup*": Docker отбрасывает "/" в конце, и правило задевает handlers_backup.py.
adasan_backup_*.zip
*.before_restore
*.bak
*.tmp
